{
  "name": "url-shortener-analytics",
  "version": "1.0.0",
  "description": "High-performance URL shortener with real-time click analytics — Redis caching, REST + GraphQL, token bucket rate limiting, TimescaleDB analytics.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "migrate": "ts-node src/db/migrate.ts",
    "seed": "ts-node scripts/seed.ts",
    "worker": "ts-node-dev --respawn --transpile-only src/workers/analyticsAggregator.worker.ts",
    "test": "jest --runInBand",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@apollo/server": "^4.10.4",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "graphql": "^16.8.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "nanoid": "^3.3.7",
    "pg": "^8.11.5",
    "pino": "^9.2.0",
    "pino-http": "^10.1.0",
    "ua-parser-js": "^1.0.38"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.11.6",
    "@types/ua-parser-js": "^0.7.39",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "pino-pretty": "^11.2.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
